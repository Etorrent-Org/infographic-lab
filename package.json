{
  "name": "infographic-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run test:visual && npm run test:browser",
    "test:visual": "node --experimental-strip-types --test tests/visual-layouts.test.mjs",
    "test:browser": "playwright test tests/visual-browser.spec.mjs tests/preview-visual-browser.spec.mjs",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@antv/infographic": "0.2.19",
    "mermaid": "^11.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  }
}
