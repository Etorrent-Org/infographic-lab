# Port de test Augmented. La version stable reste sur 3091.
AUGMENTED_PORT=3092
AUGMENTED_BIND=127.0.0.1

# Jeton interne partagé entre l'application et les runners.
RUNNER_SHARED_TOKEN=change-me-with-a-long-random-value

# Réutilise par défaut le profil Vibe existant de la version stable.
VIBE_HOME_VOLUME=infographic-lab_vibe_home
MISTRAL_API_KEY=

# Volume Codex persistant. Peut pointer vers un volume Docker Codex déjà authentifié.
CODEX_HOME_VOLUME=infographic-lab_codex_home
CODEX_VERSION=latest

# Ordre utilisé par le mode Automatique.
AI_PROVIDER_ORDER=ollama,vibe,codex

# Ollama: URL via reseau Docker externe (voir docker-compose.ollama.yml).
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
