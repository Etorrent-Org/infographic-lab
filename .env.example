# Required for a fresh installation using Mistral Vibe.
MISTRAL_API_KEY=

# Optional: select the published Docker Hub image tag. Default: 1.0.0.
INFOGRAPHIC_LAB_IMAGE_TAG=1.0.0

# Optional: reuse an existing Docker volume containing a configured Vibe profile.
VIBE_HOME_VOLUME=infographic-lab_vibe_home

# Optional. START-INFOGRAPHIC-LAB.ps1 generates an internal token when absent.
RUNNER_SHARED_TOKEN=
